# Cấu hình chung cho mọi phòng ban. Sao chép thành env/common.env (KHÔNG commit).

# Odoo chạy cùng server. Odoo trong Docker có cổng publish thì vẫn là 127.0.0.1:<port>.
ODOO_URL=http://127.0.0.1:8069
# Bắt buộc ghi rõ tên database: Odoo 20 đã bỏ endpoint /xmlrpc/db nên không tự dò được.
ODOO_DB=ten_database

# Chế độ chuẩn: module MCP phía Odoo kiểm soát model. KHÔNG đổi trên dữ liệu thật.
ODOO_YOLO=off
ODOO_MCP_ENABLE_METHOD_CALLS=false

# Ngôn ngữ phải đã cài trong Odoo (Settings > Languages), nếu không server từ chối.
ODOO_LOCALE=vi_VN

# HTTP chỉ lắng nghe localhost; proxy (Caddy/Nginx) đứng trước.
ODOO_MCP_TRANSPORT=streamable-http
ODOO_MCP_HOST=127.0.0.1
# Tên miền công khai của proxy — chống DNS rebinding. Phải trùng MCP_DOMAIN trong proxy.env.
ODOO_MCP_ALLOWED_HOSTS=mcp.example.vn
ODOO_MCP_SESSION_IDLE_TIMEOUT=1800

ODOO_MCP_DEFAULT_LIMIT=25
ODOO_MCP_MAX_LIMIT=100
ODOO_MCP_MAX_BINARY_SIZE=20971520

ODOO_MCP_LOG_LEVEL=INFO
ODOO_MCP_LOG_JSON=true
